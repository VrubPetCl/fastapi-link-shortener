# FastAPI URL Shortener - Environment Configuration
# Copy this file to .env and configure for your environment

# ==============================================================================
# JWT SECRET KEY (REQUIRED FOR PRODUCTION)
# ==============================================================================
# Generate a secure secret key using: python generate-secret.py
# This key is used to sign JWT authentication tokens
# WARNING: Never commit this to version control!
# If changed, all existing user sessions will be invalidated
JWT_SECRET_KEY=your-secret-key-here

# ==============================================================================
# HTTPS/REVERSE PROXY CONFIGURATION
# ==============================================================================
# Set to 'true' when running behind a reverse proxy (nginx, caddy, traefik, etc.)
# that handles HTTPS termination. This enables:
# - Secure cookies (even though app runs on HTTP locally)
# - Proper handling of X-Forwarded-Proto and X-Forwarded-For headers
# - Correct client IP logging from proxy headers
#
# Set to 'false' for local development without HTTPS
FORCE_HTTPS=true

# ==============================================================================
# USER REGISTRATION
# ==============================================================================
# Set to 'true' to allow new users to register accounts
# Set to 'false' to disable public registration (for private instances)
ENABLE_REGISTRATION=false

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Database path is hardcoded to ./shortener.db
# To use a different path, modify app/db/schema.py

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# These are typically passed to uvicorn command line, not environment variables
# Examples:
#   uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
#
# For production, consider:
# - Multiple workers (--workers 4)
# - Behind reverse proxy (nginx, caddy)
# - Process manager (systemd, supervisor)
# - Log rotation
